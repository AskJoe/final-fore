{
  "name": "final-fore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3107",
    "prebuild": "node scripts/install-render-libreoffice.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3107",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migration:export": "python3 scripts/export_legacy.py",
    "migration:prepare": "tsx scripts/prepare-import.ts",
    "test:browser:build": "NEXT_TELEMETRY_DISABLED=1 FINAL_FORE_TEST_BUILD=1 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-test-key next build",
    "test:browser": "NEXT_TELEMETRY_DISABLED=1 FINAL_FORE_TEST_BUILD=1 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-test-key tsx scripts/check-local.ts",
    "preview:local": "npm run local",
    "local": "node scripts/start-local.mjs",
    "backend:start": "node scripts/start-local.mjs --backend-only",
    "backend:stop": "DOCKER_CONTEXT=desktop-linux SUPABASE_TELEMETRY_DISABLED=1 supabase stop --project-id final-fore-local"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "decimal.js": "10.6.0",
    "file-type": "22.3.0",
    "html-to-text": "10.0.1",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.0",
    "sanitize-html": "2.18.1",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
