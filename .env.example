NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Media research: leave both gates off until database/storage setup and sending are approved.
FINAL_FORE_RESEARCH_WRITES_ENABLED=0
FINAL_FORE_RESEARCH_SEND_ENABLED=0
# Enable on web and worker only after the reviewed upload-lease migration is applied.
FINAL_FORE_RESEARCH_UPLOAD_WORKER_ENABLED=0
# Required on the hosted test deployment: blocks vendor sends at API and Resend boundaries.
FINAL_FORE_RESEARCH_TEST_ONLY=1
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FINAL_FORE_RESEARCH_ORIGIN=
FINAL_FORE_RESEARCH_REPLY_DOMAIN=
FINAL_FORE_RESEARCH_FROM=sarah@finalforemedia.com
FINAL_FORE_RESEARCH_SARAH_EMAIL=sarah@finalforemedia.com
# Exactly 32 random bytes, represented as 64 hexadecimal characters. Back up securely.
FINAL_FORE_RESEARCH_SECRET_KEY=
FINAL_FORE_RESEARCH_SCANNER_URL=
FINAL_FORE_RESEARCH_SCANNER_KEY=
# Optional. 1 also scans files reps upload through their link. Uploads then depend on the scanner.
FINAL_FORE_RESEARCH_SCAN_PORTAL_UPLOADS=0
